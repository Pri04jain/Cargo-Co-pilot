# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=cargo
POSTGRES_PASSWORD=cargo_secret
POSTGRES_DB=cargo_copilot
DATABASE_URL=postgresql+asyncpg://cargo:cargo_secret@db:5432/cargo_copilot
DATABASE_URL_SYNC=postgresql://cargo:cargo_secret@db:5432/cargo_copilot

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change_me_to_a_long_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── File storage ──────────────────────────────────────────────────────────────
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff

# ── LLM provider (swappable) ──────────────────────────────────────────────────
LLM_PROVIDER=openai          # openai | anthropic | azure_openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-your-key-here
LLM_MAX_RETRIES=3
LLM_TIMEOUT_SECONDS=60

# ── Langfuse observability (optional) ────────────────────────────────────────
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
